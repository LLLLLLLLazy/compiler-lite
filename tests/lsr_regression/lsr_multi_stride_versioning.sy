int out_fast[64];
int out_negative[64];
int out_short[64];
int input_b[64];
int input_c[64];
int input_d[64];
int input_e[64];

int scan(int out[], int b[], int c[], int d[], int e[], int stride, int count, int x, int y) {
    int i = 0;
    while (i < count) {
        int index = i * stride + 20;
        out[index] = b[index] + c[index] + d[index] + e[index];
        i = i + 1;
    }
    return out[20 + x + y] + out[12] + out[28];
}

int main() {
    input_b[12] = 12;
    input_b[20] = 20;
    input_b[28] = 28;

    putint(scan(out_fast, input_b, input_c, input_d, input_e, 1, 9, 0, 0));
    putch(10);
    putint(scan(out_negative, input_b, input_c, input_d, input_e, -1, 9, 0, 0));
    putch(10);
    putint(scan(out_short, input_b, input_c, input_d, input_e, 1, 4, 0, 0));
    putch(10);
    return 0;
}
