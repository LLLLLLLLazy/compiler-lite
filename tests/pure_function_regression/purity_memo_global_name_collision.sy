int _memo_hash_key0_fibonacci;

int fibonacci(int value)
{
    if (value <= 1) {
        return value;
    }
    return fibonacci(value - 1) + fibonacci(value - 2);
}

int keep_global(int depth)
{
    if (depth <= 0) {
        return _memo_hash_key0_fibonacci;
    }
    _memo_hash_key0_fibonacci = _memo_hash_key0_fibonacci + depth;
    return keep_global(depth - 1);
}

int main()
{
    _memo_hash_key0_fibonacci = getint();
    int result = fibonacci(12);
    int global_value = keep_global(2);
    return result - 144 + global_value - 20;
}
