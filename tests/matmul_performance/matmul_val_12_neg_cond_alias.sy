// 条件归约别名反例，第二组 X 与输出重叠时交换会改变后续读取值
int A[16][16];
int B[16][16];
int C[16][16];

int main() {
    int i = 0;
    while (i < 16) {
        int j = 0;
        while (j < 16) {
            A[i][j] = (i * 2 + j * 3 + 1) % 3 - 1;
            B[i][j] = (i * 5 + j * 4 + 2) % 5 - 2;
            C[i][j] = (i * 7 + j * 2 + 4) % 3 - 1;
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < 16) {
        int j = 0;
        while (j < 16) {
            int k = 0;
            int sum = 0;
            while (k < 16) {
                if (A[i][k] * B[k][j] % 2 == 0) {
                    sum = sum + C[i][k] * A[k][j];
                }
                k = k + 1;
            }
            C[i][j] = sum;
            j = j + 1;
        }
        i = i + 1;
    }

    int checksum = 0;
    i = 0;
    while (i < 16) {
        int j = 0;
        while (j < 16) {
            checksum = checksum + C[i][j] * (i + j + 1);
            j = j + 1;
        }
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
