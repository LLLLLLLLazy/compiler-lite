// 基础形态: C = A * B, 三个不同数组, 运行期方阵规模 -> 直接累加进 C 行(无缓冲无 guard)
int A[128][128];
int B[128][128];
int C[128][128];

int main() {
    int n = getint();
    int i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            A[i][j] = getint();
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            B[i][j] = getint();
            j = j + 1;
        }
        i = i + 1;
    }

    starttime();
    i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            int k = 0;
            int sum = 0;
            while (k < n) {
                sum = sum + A[i][k] * B[k][j];
                k = k + 1;
            }
            C[i][j] = sum;
            j = j + 1;
        }
        i = i + 1;
    }
    stoptime();

    int total = 0;
    i = 0;
    while (i < n) {
        int j = 0;
        while (j < n) {
            total = total + C[i][j];
            j = j + 1;
        }
        i = i + 1;
    }
    putint(total);
    putch(10);
    putint(C[0][0]);
    putch(10);
    putint(C[n - 1][n - 1]);
    putch(10);
    return 0;
}
