// 条件归约正例，交换后必须保持条件分支且得到相同结果
int A[32][32];
int B[32][32];
int C[32][32];

int main() {
    int i = 0;
    while (i < 32) {
        int j = 0;
        while (j < 32) {
            A[i][j] = (i * 3 + j * 5 + 1) % 17 - 8;
            B[i][j] = (i * 7 - j * 2 + 3) % 19 - 9;
            j = j + 1;
        }
        i = i + 1;
    }

    i = 0;
    while (i < 32) {
        int j = 0;
        while (j < 32) {
            int k = 0;
            int sum = 0;
            while (k < 32) {
                if (A[i][k] * B[k][j] % 2 == 0) {
                    sum = sum + B[i][k] * A[k][j];
                }
                k = k + 1;
            }
            C[i][j] = sum;
            j = j + 1;
        }
        i = i + 1;
    }

    int checksum = 0;
    i = 0;
    while (i < 32) {
        int j = 0;
        while (j < 32) {
            checksum = checksum + C[i][j] * (i + j + 1);
            j = j + 1;
        }
        i = i + 1;
    }
    putint(checksum);
    putch(10);
    return 0;
}
